<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<!-- Bengie: no code. Requires the current release of every Bengie add-on, so
     updating this one brings them all to the same release. tools/make_build.py
     bumps it and sets these versions whenever any of them changed. -->
<addon id="script.benjie.bundle" name="Bengie add-ons" version="1.0.1" provider-name="ahmadashwah">
	<requires>
		<import addon="xbmc.python" version="3.0.0" />
		<import addon="service.iptvhelperfixes" version="1.9.7" />
		<import addon="plugin.video.xstream-player" version="2.1.5.5" />
		<import addon="plugin.video.tmdb.bingie.helper" version="1.0.3.4" />
		<import addon="script.bingie.widgets" version="1.0.1.2" />
		<import addon="script.bingie.helper" version="1.1.2" />
		<import addon="script.bingie.toolbox" version="1.0.0" />
		<import addon="script.module.bingie" version="1.0.1" />
	</requires>
	<extension point="xbmc.python.module" library="lib" />
	<extension point="xbmc.addon.metadata">
		<summary lang="en_GB">Keeps the Bengie add-ons on one release</summary>
		<description lang="en_GB">Installed with the Bengie skin. It has no settings and does nothing by itself: it requires the current version of every Bengie add-on (XStream Player, TMDb Bingie Helper, Bingie Widgets, the Bingie scripts and IPTV Helper Fixes), so they update together.</description>
		<platform>all</platform>
		<license>GPL-2.0-or-later</license>
		<source>https://github.com/ahmadashwah/BenjiePatches/tree/main/script.benjie.bundle</source>
		<assets>
			<icon>icon.png</icon>
		</assets>
	</extension>
</addon>
