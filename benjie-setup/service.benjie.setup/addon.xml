<?xml version="1.0" encoding="UTF-8" standalone="yes"?>
<addon id="service.benjie.setup" name="Benjie Setup" version="1.0.2" provider-name="ahmadashwah">
    <requires>
        <import addon="xbmc.python" version="3.0.0"/>
    </requires>
    <extension point="xbmc.service" library="service.py" start="startup"/>
    <extension point="xbmc.python.script" library="run.py">
        <provides>executable</provides>
    </extension>
    <extension point="xbmc.addon.metadata">
        <summary lang="en_GB">One-step setup for the Benjie Kodi build</summary>
        <description lang="en_GB">Installs the Bingie skin, the Benjie helper add-ons and their settings in one step, then switches Kodi to the skin. Runs once after it is installed.</description>
        <platform>all</platform>
        <license>GPL-2.0-or-later</license>
    </extension>
</addon>
