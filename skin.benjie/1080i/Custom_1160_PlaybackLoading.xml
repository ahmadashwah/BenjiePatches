<?xml version="1.0" encoding="UTF-8"?>
<!-- IPTV Helper Fixes: black screen + spinner while a play request is being resolved
     (skin dialogs with a <visible> condition open and close themselves, so this
     one shows while Window(Home).Property(PlaybackLoading) is set by XStream
     Player's play_stream and the info dialog's Play buttons, and the service
     clears it when playback starts). The spinner hides while a select
     dialog (e.g. choosing a server) is showing so it never competes with it. -->
<!-- Bengie: the whole screen (not only the spinner) steps aside while a dialog
     that needs an answer is open: a resume menu, a server or source picker, a
     yes/no or OK question, the keyboard, a progress box. Opened after them, it
     used to cover them (the "Resume from" menu was hidden behind it, so the
     spinner seemed stuck). It comes back by itself once the dialog closes. -->
<window type="dialog" id="1160">
    <visible>!Player.HasVideo + String.IsEqual(Window(Home).Property(PlaybackLoading),1)</visible>
    <visible>!Window.IsActive(contextmenu) + !Window.IsActive(selectdialog) + !Window.IsActive(yesnodialog) + !Window.IsActive(okdialog) + !Window.IsActive(virtualkeyboard) + !Window.IsActive(numericinput) + !Window.IsActive(progressdialog)</visible>
    <onload>AlarmClock(ClosePlaybackLoading,ClearProperty(PlaybackLoading,Home),01:00,silent)</onload>
    <onunload condition="System.HasAlarm(ClosePlaybackLoading)">CancelAlarm(ClosePlaybackLoading,true)</onunload>
    <controls>
        <control type="image">
            <left>0</left>
            <top>0</top>
            <width>1920</width>
            <height>1080</height>
            <texture>colors/color_black.png</texture>
        </control>
        <include content="Busy_Spinner">
            <param name="size" value="160" />
            <param name="visibility" value="!Window.IsActive(selectdialog) + !Window.IsActive(DialogSelect.xml)" />
        </include>
        <!-- Bengie (issue #6): how far along it is. TMDb Bingie Helper sets 5%
             at the click, XStream Player raises it per step (search 15, show 30,
             episodes 50, stream 75) and the service sets 90 when Kodi opens the
             video. Real steps, not a timer, so it never runs ahead. -->
        <control type="label">
            <centertop>50%</centertop>
            <centerleft>50%</centerleft>
            <width>160</width>
            <height>60</height>
            <align>center</align>
            <aligny>center</aligny>
            <font>Bold26</font>
            <textcolor>FFFFFFFF</textcolor>
            <label>$INFO[Window(Home).Property(PlaybackLoadingPercent),,%]</label>
            <visible>!String.IsEmpty(Window(Home).Property(PlaybackLoadingPercent))</visible>
        </control>
        <control type="label">
            <left>0</left>
            <top>640</top>
            <width>1920</width>
            <height>50</height>
            <align>center</align>
            <aligny>center</aligny>
            <font>Reg30</font>
            <textcolor>B3FFFFFF</textcolor>
            <label>$INFO[Window(Home).Property(PlaybackLoadingStep)]</label>
        </control>
    </controls>
</window>
